{
  "name": "LobaMall · El centro comercial de La Loba",
  "short_name": "LobaMall",
  "description": "El centro comercial digital de La Loba (Hatillo, San Martín y Barranco de Loba) en una sola app: pide, sigue tu domicilio en vivo y paga en efectivo, Nequi o fiado. Para negocios: ventas, caja, inventario con QR y repartidores. Para mototaxistas: domicilios en modo trabajo y compras en modo cliente.",
  "lang": "es-CO",
  "start_url": "./index.html?app=1#inicio",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDEDED",
  "theme_color": "#FFE600",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ofertas de hoy",
      "url": "./index.html#c-ofertas"
    },
    {
      "name": "Mis pedidos",
      "url": "./index.html#cuenta-pedidos"
    },
    {
      "name": "Entrar a mi negocio",
      "url": "./index.html#panel"
    },
    {
      "name": "Repartidores",
      "url": "./index.html?app=1#rep"
    },
    {
      "name": "Escanear un producto",
      "url": "./index.html#escanear"
    }
  ],
  "id": "./index.html?app=1",
  "categories": [
    "shopping",
    "food",
    "business"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "screenshots": [
